# 공개 UI 설정 (원하는 값만 복사해 .env.local에 넣으세요)
NEXT_PUBLIC_APP_NAME="Cloudscope"
NEXT_PUBLIC_APP_BADGE="PERSONAL"
NEXT_PUBLIC_APP_MARK="C"
NEXT_PUBLIC_OWNER_LABEL="MY CLOUD"
NEXT_PUBLIC_APP_DESCRIPTION="Google Cloud와 Firebase 사용량을 한눈에 확인하는 개인용 대시보드"
NEXT_PUBLIC_ACCENT_COLOR="#2962ff"

# OAuth 클라이언트 ID는 공개 식별자이며 비밀 키가 아닙니다.
# 비워 두면 각 사용자가 앱의 연결 설정 화면에서 직접 입력합니다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# 같은 도메인에 대시보드를 여러 개 운영할 때 서로 다른 키를 지정하세요.
NEXT_PUBLIC_STORAGE_KEY="cloudscope.google-client-id"
